{
  "version": "1.0.0",
  "models": [
    {
      "id": "example-provider/example-model-free",
      "provider": "example-provider",
      "displayName": "Example Free Model",
      "capabilities": ["coding", "reasoning", "analysis", "writing"],
      "priority": 80,
      "costClassification": "free",
      "enabled": true,
      "fallbacks": []
    },
    {
      "id": "example-provider/example-model-paid",
      "provider": "example-provider",
      "displayName": "Example Paid Model",
      "capabilities": ["coding", "reasoning", "analysis", "writing", "vision"],
      "priority": 90,
      "costClassification": "paid",
      "estimatedCostPer1kTokens": 0.003,
      "estimatedLatencyMs": 800,
      "enabled": true,
      "fallbacks": ["example-provider/example-model-free"]
    }
  ],
  "categories": [
    {
      "id": "general",
      "name": "General Purpose",
      "description": "Balanced routing for general tasks",
      "modelIds": ["example-provider/example-model-free", "example-provider/example-model-paid"],
      "defaultStrategy": "capability-match",
      "enabled": true
    },
    {
      "id": "coding",
      "name": "Software Development",
      "description": "Optimized for coding tasks",
      "modelIds": ["example-provider/example-model-free", "example-provider/example-model-paid"],
      "defaultStrategy": "capability-match",
      "enabled": true
    }
  ],
  "defaultCategory": "general",
  "defaultStrategy": "capability-match",
  "strategyWeights": {
    "capability-match": 0.5,
    "cost-optimize": 0.1,
    "latency-optimize": 0.1,
    "quota-aware": 0.1,
    "priority-based": 0.2,
    "round-robin": 0.0,
    "custom": 0.0
  },
  "costPolicy": {
    "freeOnly": false,
    "maxCostPerRequest": 0.5,
    "maxCostPerSession": 10.0,
    "warnThreshold": 0.8,
    "budgetPeriodHours": 24
  },
  "cooldownConfig": {
    "enabled": true,
    "defaultCooldownMs": 60000,
    "maxCooldownMs": 3600000,
    "backoffMultiplier": 2.0,
    "resetOnSuccess": true
  },
  "shadowMode": {
    "enabled": false,
    "shadowModelIds": [],
    "logDecisions": true,
    "sampleRate": 0.1
  },
  "multiAgent": {
    "mode": "manual",
    "requirePreview": true,
    "stopOnModelFailure": true,
    "noParallelFsWrites": true,
    "enforceAllowlists": true,
    "previewNoQuotaConsumption": true,
    "enforceGuards": true
  },
  "metadata": {
    "description": "Example QuotaWeave routing configuration. Replace model IDs with your actual OpenCode provider model IDs.",
    "notes": [
      "This is an EXAMPLE configuration. Do not commit real model IDs or credentials.",
      "The global model allowlist is authoritative. Project configs may only restrict it.",
      "Free-only mode is controlled by costPolicy.freeOnly, not a category.",
      "Unknown costClassification models are treated as paid in free-only mode",
      "Project configurations are merged on top and can only remove models/categories"
    ]
  }
}
